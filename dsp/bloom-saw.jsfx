desc:Bloom Saw - 7-voice supersaw for future bass chords (8-note poly)
// SPDX-License-Identifier: Apache-2.0
// Each note stacks 7 PolyBLEP (anti-aliased) saws detuned symmetrically by
// d * {-1, -2/3, -1/3, 0, 1/3, 2/3, 1} cents. The outer pairs are panned
// furthest, so width grows with detune while the centre saw anchors the mono sum.
// A 12 dB/oct state-variable lowpass (Zavalishin TPT form) per voice opens on
// each note: cutoff = base * 2^(amount * fenv + 1.5 * velocity + 2 * modwheel),
// with fenv decaying exponentially, so chords "bloom" bright then settle.
// Random start phases stop every chord from attacking with the same comb filter.
// MIDI: notes, pitch bend (+/-2 semitones), CC1 opens the filter, CC64 sustain.
slider1:22<0,60,0.1>Detune (cents)
slider2:0.8<0,1,0.01>Stereo width
slider3:900<80,12000,1>Cutoff (Hz)
slider4:3<0,6,0.01>Filter env amount (oct)
slider5:0.45<0.02,4,0.01>Filter env decay (s)
slider6:0.15<0,0.9,0.01>Resonance
slider7:0.005<0.001,2,0.001>Attack (s)
slider8:1.2<0.05,8,0.01>Decay (s)
slider9:0.6<0,1,0.01>Sustain
slider10:0.35<0.01,4,0.01>Release (s)
slider11:0.6<0,1,0.01>Volume

@init
NV = 8;
NU = 7;  // unison saws per voice (EEL2 names are case-insensitive: not 'U', which is 'u')
note = 0;        // per voice, -1 = free
vel = 16;
stage = 32;      // 0 off, 1 attack, 2 decay/sustain, 3 release
env = 48;
fenv = 64;
age = 80;
freq = 96;
held = 112;      // key physically down (for sustain pedal)
c1L = 128; c2L = 144; c1R = 160; c2R = 176;
ph = 200;        // NV * NU phases
detr = 300;      // NU detune ratios
pl = 310; pr = 320;
v = 0;
loop(NV, note[v] = -1; stage[v] = 0; env[v] = 0; v += 1;);
v = 0;
loop(NV * NU, ph[v] = rand(1); v += 1;);
bend = 1;
mw = 0;
sustainPedal = 0;
clock = 0;

@slider
// Unison order: outer pairs first in pan, so pos and pan line up
u = 0;
loop(NU,
  pos = (u - 3) / 3;
  detr[u] = 2 ^ (slider1 * pos / 1200);
  p = slider2 * pos;
  pl[u] = cos((p + 1) * $pi / 4);
  pr[u] = sin((p + 1) * $pi / 4);
  u += 1;
);
cut = slider3;
envAmt = slider4;
kFenv = exp(-1 / (slider5 * srate));
k = 2 - 2 * slider6;
atkInc = 1 / (slider7 * srate);
kDec = exp(-1 / (slider8 * srate));
sus = slider9;
kRel = exp(-1 / (slider10 * srate));
gain = slider11 * 0.12;

@block
while (midirecv(ofs, m1, m2, m3)) (
  st = m1 & 0xF0;
  (st == 0x90 && m3 > 0) ? (
    // Free voice first, otherwise the oldest
    best = -1;
    v = 0;
    loop(NV, (best < 0 && stage[v] == 0) ? (best = v); v += 1;);
    (best < 0) ? (
      best = 0;
      v = 1;
      loop(NV - 1, (age[v] < age[best]) ? (best = v); v += 1;);
    );
    clock += 1;
    note[best] = m2;
    vel[best] = m3 / 127;
    freq[best] = 440 * 2 ^ ((m2 - 69) / 12);
    stage[best] = 1;
    fenv[best] = 1;
    age[best] = clock;
    held[best] = 1;
  ) : (st == 0x80 || st == 0x90) ? (
    v = 0;
    loop(NV,
      (note[v] == m2 && stage[v] && stage[v] < 3) ? (
        held[v] = 0;
        sustainPedal ? 0 : (stage[v] = 3);
      );
      v += 1;
    );
  ) : (st == 0xE0) ? (
    bend = 2 ^ (((m3 * 128 + m2) - 8192) / 8192 * 2 / 12);
  ) : (st == 0xB0) ? (
    (m2 == 1) ? (mw = m3 / 127);
    (m2 == 64) ? (
      sustainPedal = (m3 >= 64);
      sustainPedal ? 0 : (
        v = 0;
        loop(NV, (stage[v] && stage[v] < 3 && !held[v]) ? (stage[v] = 3); v += 1;);
      );
    );
    (m2 == 120 || m2 == 123) ? (
      v = 0;
      loop(NV, stage[v] = 0; env[v] = 0; v += 1;);
    );
  );
);

@sample
outL = outR = 0;
v = 0;
loop(NV,
  stage[v] ? (
    (stage[v] == 1) ? (
      env[v] += atkInc;
      (env[v] >= 1) ? (env[v] = 1; stage[v] = 2;);
    ) : (stage[v] == 2) ? (
      env[v] = sus + (env[v] - sus) * kDec;
    ) : (
      env[v] *= kRel;
      (env[v] < 0.0001) ? (stage[v] = 0; env[v] = 0;);
    );
    fenv[v] *= kFenv;

    fc = min(cut * 2 ^ (envAmt * fenv[v] + 1.5 * vel[v] + 2 * mw), 0.45 * srate);
    g = tan($pi * fc / srate);
    a1 = 1 / (1 + g * (g + k));
    a2 = g * a1;
    a3 = g * a2;

    sL = sR = 0;
    base = freq[v] * bend / srate;
    idx = v * NU;
    u = 0;
    loop(NU,
      dt = base * detr[u];
      t = ph[idx + u] + dt;
      (t >= 1) ? (t -= 1);
      ph[idx + u] = t;
      x = 2 * t - 1;
      (t < dt) ? (
        y = t / dt;
        x -= y + y - y * y - 1;
      ) : (t > 1 - dt) ? (
        y = (t - 1) / dt;
        x -= y * y + y + y + 1;
      );
      sL += x * pl[u];
      sR += x * pr[u];
      u += 1;
    );

    v3 = sL - c2L[v];
    v1 = a1 * c1L[v] + a2 * v3;
    v2 = c2L[v] + a2 * c1L[v] + a3 * v3;
    c1L[v] = 2 * v1 - c1L[v];
    c2L[v] = 2 * v2 - c2L[v];
    lpL = v2;

    v3 = sR - c2R[v];
    v1 = a1 * c1R[v] + a2 * v3;
    v2 = c2R[v] + a2 * c1R[v] + a3 * v3;
    c1R[v] = 2 * v1 - c1R[v];
    c2R[v] = 2 * v2 - c2R[v];
    lpR = v2;

    a = env[v] * (0.35 + 0.65 * vel[v]);
    outL += lpL * a;
    outR += lpR * a;
  );
  v += 1;
);
spl0 = outL * gain;
spl1 = outR * gain;
