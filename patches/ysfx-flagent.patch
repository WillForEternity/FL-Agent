diff --git a/tools/flagent_render.cpp b/tools/flagent_render.cpp
new file mode 100644
index 0000000..a40e52d
--- /dev/null
+++ b/tools/flagent_render.cpp
@@ -0,0 +1,276 @@
+// FL-Agent offline JSFX renderer and checker (not part of upstream ysfx).
+//
+// Renders a JSFX script without a DAW and reports whether it compiles, its
+// sliders, and level statistics, so effects and instruments can be checked
+// before anyone hears them.
+//
+// Usage:
+//   flagent_render SCRIPT [options]
+//     --seconds S        total render length (default 4)
+//     --notes N,N,...    MIDI notes to play at t=0 (instrument test)
+//     --velocity V       note-on velocity (default 100)
+//     --hold S           seconds before note-offs (default 1.5)
+//     --input KIND       audio fed to the script: none|noise|sine|pluck (default none)
+//     --input-seconds S  how long the input lasts (default 0.5)
+//     --tempo BPM        host tempo, playing from beat 0 (default 120)
+//     --slider I=V       set slider I (1-based, as in the script) before rendering
+//     --wav PATH         also write a 32-bit float stereo WAV
+//     --rate HZ          sample rate (default 48000)
+//
+// Prints one JSON object. Exit code: 0 ok, 1 usage error, 2 compile/load error.
+
+#include "ysfx.h"
+
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <string>
+#include <vector>
+
+namespace {
+
+struct Options {
+    std::string script;
+    double seconds = 4.0;
+    std::vector<int> notes;
+    int velocity = 100;
+    double hold = 1.5;
+    std::string input = "none";
+    double inputSeconds = 0.5;
+    double tempo = 120.0;
+    std::vector<std::pair<int, double>> sliders;
+    std::string wav;
+    double rate = 48000.0;
+};
+
+std::string g_log;
+
+void logReporter(intptr_t, ysfx_log_level level, const char *message)
+{
+    g_log += (level == ysfx_log_error) ? "error: " : (level == ysfx_log_warning) ? "warning: " : "";
+    g_log += message;
+    g_log += "\n";
+}
+
+std::string jsonEscape(const std::string &s)
+{
+    std::string out;
+    for (char c : s) {
+        switch (c) {
+        case '"': out += "\\\""; break;
+        case '\\': out += "\\\\"; break;
+        case '\n': out += "\\n"; break;
+        case '\t': out += "\\t"; break;
+        default:
+            if ((unsigned char)c < 0x20) {
+                char buf[8];
+                std::snprintf(buf, sizeof(buf), "\\u%04x", c);
+                out += buf;
+            }
+            else {
+                out += c;
+            }
+        }
+    }
+    return out;
+}
+
+double toDb(double x) { return x > 0 ? 20.0 * std::log10(x) : -999.0; }
+
+bool parseArgs(int argc, char *argv[], Options &opt)
+{
+    if (argc < 2)
+        return false;
+    opt.script = argv[1];
+    for (int i = 2; i < argc; ++i) {
+        std::string a = argv[i];
+        auto next = [&]() -> const char * { return (i + 1 < argc) ? argv[++i] : nullptr; };
+        const char *v = nullptr;
+        if (a == "--seconds" && (v = next())) opt.seconds = std::atof(v);
+        else if (a == "--velocity" && (v = next())) opt.velocity = std::atoi(v);
+        else if (a == "--hold" && (v = next())) opt.hold = std::atof(v);
+        else if (a == "--input" && (v = next())) opt.input = v;
+        else if (a == "--input-seconds" && (v = next())) opt.inputSeconds = std::atof(v);
+        else if (a == "--tempo" && (v = next())) opt.tempo = std::atof(v);
+        else if (a == "--wav" && (v = next())) opt.wav = v;
+        else if (a == "--rate" && (v = next())) opt.rate = std::atof(v);
+        else if (a == "--notes" && (v = next())) {
+            std::string s = v;
+            size_t pos = 0;
+            while (pos < s.size()) {
+                size_t comma = s.find(',', pos);
+                opt.notes.push_back(std::atoi(s.substr(pos, comma - pos).c_str()));
+                if (comma == std::string::npos) break;
+                pos = comma + 1;
+            }
+        }
+        else if (a == "--slider" && (v = next())) {
+            const char *eq = std::strchr(v, '=');
+            if (!eq) return false;
+            opt.sliders.emplace_back(std::atoi(v), std::atof(eq + 1));
+        }
+        else return false;
+    }
+    return opt.seconds > 0 && opt.rate > 0;
+}
+
+void writeWav(const std::string &path, const std::vector<float> &l, const std::vector<float> &r, double rate)
+{
+    FILE *f = std::fopen(path.c_str(), "wb");
+    if (!f) return;
+    uint32_t frames = (uint32_t)l.size();
+    uint32_t dataBytes = frames * 2 * 4;
+    auto u32 = [&](uint32_t x) { std::fwrite(&x, 4, 1, f); };
+    auto u16 = [&](uint16_t x) { std::fwrite(&x, 2, 1, f); };
+    std::fwrite("RIFF", 1, 4, f); u32(36 + dataBytes); std::fwrite("WAVE", 1, 4, f);
+    std::fwrite("fmt ", 1, 4, f); u32(16); u16(3); u16(2); u32((uint32_t)rate);
+    u32((uint32_t)rate * 8); u16(8); u16(32);
+    std::fwrite("data", 1, 4, f); u32(dataBytes);
+    for (uint32_t i = 0; i < frames; ++i) {
+        std::fwrite(&l[i], 4, 1, f);
+        std::fwrite(&r[i], 4, 1, f);
+    }
+    std::fclose(f);
+}
+
+} // namespace
+
+int main(int argc, char *argv[])
+{
+    Options opt;
+    if (!parseArgs(argc, argv, opt)) {
+        std::fprintf(stderr, "usage: flagent_render SCRIPT [--notes 60,64,67] [--input noise] "
+                             "[--seconds 4] [--slider 1=0.5] [--wav out.wav] ...\n");
+        return 1;
+    }
+
+    ysfx_config_u config{ysfx_config_new()};
+    ysfx_set_log_reporter(config.get(), &logReporter);
+    ysfx_register_builtin_audio_formats(config.get());
+    ysfx_u fx{ysfx_new(config.get())};
+
+    const uint32_t block = 256;
+    bool ok = ysfx_load_file(fx.get(), opt.script.c_str(), 0) &&
+              ysfx_compile(fx.get(), ysfx_compile_no_gfx);
+    if (!ok) {
+        std::printf("{\"compiled\": false, \"log\": \"%s\"}\n", jsonEscape(g_log).c_str());
+        return 2;
+    }
+    ysfx_set_sample_rate(fx.get(), opt.rate);
+    ysfx_set_block_size(fx.get(), block);
+    ysfx_init(fx.get());
+
+    for (auto &s : opt.sliders)
+        ysfx_slider_set_value(fx.get(), (uint32_t)(s.first - 1), s.second, true);
+
+    // Slider list for the report
+    std::string sliders = "[";
+    for (uint32_t i = 0; i < ysfx_max_sliders; ++i) {
+        if (!ysfx_slider_exists(fx.get(), i)) continue;
+        if (sliders.size() > 1) sliders += ", ";
+        char buf[64];
+        std::snprintf(buf, sizeof(buf), "%g", ysfx_slider_get_value(fx.get(), i));
+        sliders += "{\"index\": " + std::to_string(i + 1) + ", \"name\": \"" +
+                   jsonEscape(ysfx_slider_get_name(fx.get(), i)) + "\", \"value\": " + buf + "}";
+    }
+    sliders += "]";
+
+    const uint64_t total = (uint64_t)(opt.seconds * opt.rate);
+    const uint64_t inputFrames = (uint64_t)(opt.inputSeconds * opt.rate);
+    const uint64_t noteOffFrame = (uint64_t)(opt.hold * opt.rate);
+
+    std::vector<float> outL, outR;
+    outL.reserve(total);
+    outR.reserve(total);
+    std::vector<float> inBufL(block), inBufR(block), outBufL(block), outBufR(block);
+    std::mt19937 rng(1234);
+    std::uniform_real_distribution<float> uni(-1.0f, 1.0f);
+
+    bool notesOn = false, notesOff = opt.notes.empty();
+    double inputPhase = 0;
+    for (uint64_t pos = 0; pos < total; pos += block) {
+        uint32_t n = (uint32_t)std::min<uint64_t>(block, total - pos);
+
+        ysfx_time_info_t ti{};
+        ti.tempo = opt.tempo;
+        ti.playback_state = ysfx_playback_playing;
+        ti.time_position = (double)pos / opt.rate;
+        ti.beat_position = ti.time_position * opt.tempo / 60.0;
+        ti.time_signature[0] = 4;
+        ti.time_signature[1] = 4;
+        ysfx_set_time_info(fx.get(), &ti);
+
+        if (!notesOn && !opt.notes.empty()) {
+            for (int note : opt.notes) {
+                uint8_t msg[3] = {0x90, (uint8_t)note, (uint8_t)opt.velocity};
+                ysfx_midi_event_t ev{0, 0, 3, msg};
+                ysfx_send_midi(fx.get(), &ev);
+            }
+            notesOn = true;
+        }
+        if (!notesOff && pos >= noteOffFrame) {
+            for (int note : opt.notes) {
+                uint8_t msg[3] = {0x80, (uint8_t)note, 0};
+                ysfx_midi_event_t ev{0, 0, 3, msg};
+                ysfx_send_midi(fx.get(), &ev);
+            }
+            notesOff = true;
+        }
+
+        for (uint32_t i = 0; i < n; ++i) {
+            float x = 0;
+            uint64_t t = pos + i;
+            if (t < inputFrames) {
+                if (opt.input == "noise") x = 0.3f * uni(rng);
+                else if (opt.input == "sine") x = 0.5f * (float)std::sin(inputPhase);
+                else if (opt.input == "pluck") x = 0.6f * (float)std::sin(inputPhase) * (float)std::exp(-8.0 * t / opt.rate);
+                inputPhase += 2 * M_PI * 440.0 / opt.rate;
+            }
+            inBufL[i] = x;
+            inBufR[i] = x;
+        }
+        const float *ins[2] = {inBufL.data(), inBufR.data()};
+        float *outs[2] = {outBufL.data(), outBufR.data()};
+        ysfx_process_float(fx.get(), ins, outs, 2, 2, n);
+        outL.insert(outL.end(), outBufL.begin(), outBufL.begin() + n);
+        outR.insert(outR.end(), outBufR.begin(), outBufR.begin() + n);
+    }
+
+    // Statistics: whole render, and the last 10% (decay / runaway check)
+    uint64_t nonFinite = 0;
+    double peakL = 0, peakR = 0, sumL = 0, sumR = 0, sumSqL = 0, sumSqR = 0, sumLR = 0;
+    double tailSq = 0;
+    const uint64_t tailStart = total - total / 10;
+    for (uint64_t i = 0; i < total; ++i) {
+        double l = outL[i], r = outR[i];
+        if (!std::isfinite(l) || !std::isfinite(r)) { ++nonFinite; continue; }
+        peakL = std::max(peakL, std::fabs(l));
+        peakR = std::max(peakR, std::fabs(r));
+        sumL += l; sumR += r;
+        sumSqL += l * l; sumSqR += r * r; sumLR += l * r;
+        if (i >= tailStart) tailSq += 0.5 * (l * l + r * r);
+    }
+    double N = (double)total;
+    double rmsL = std::sqrt(sumSqL / N), rmsR = std::sqrt(sumSqR / N);
+    double tailRms = std::sqrt(tailSq / (double)(total - tailStart));
+    double corr = (sumSqL > 0 && sumSqR > 0) ? sumLR / std::sqrt(sumSqL * sumSqR) : 0;
+    double peak = std::max(peakL, peakR);
+
+    if (!opt.wav.empty())
+        writeWav(opt.wav, outL, outR, opt.rate);
+
+    std::printf(
+        "{\"compiled\": true, \"sliders\": %s, \"peak_db\": %.2f, \"peak_l_db\": %.2f, "
+        "\"peak_r_db\": %.2f, \"rms_db\": %.2f, \"tail_rms_db\": %.2f, \"dc_offset\": %.6f, "
+        "\"stereo_correlation\": %.3f, \"non_finite_samples\": %llu, \"clipping\": %s, "
+        "\"silent\": %s, \"log\": \"%s\"}\n",
+        sliders.c_str(), toDb(peak), toDb(peakL), toDb(peakR),
+        toDb(std::sqrt(0.5 * (rmsL * rmsL + rmsR * rmsR))), toDb(tailRms),
+        0.5 * (sumL + sumR) / N, corr, (unsigned long long)nonFinite,
+        peak > 1.0 ? "true" : "false", peak < 1e-5 ? "true" : "false",
+        jsonEscape(g_log).c_str());
+    return 0;
+}
