+
+//==============================================================================
+// FL-Agent modifications (not part of upstream ysfx):
+// - A new instance loads the script named in pending.txt, if FL-Agent wrote one
+//   in the last 30 seconds. This lets an external tool choose which script a
+//   freshly created plugin runs without using the GUI.
+// - The loaded script is reloaded (keeping slider values) whenever its file
+//   changes on disk.
+// - An extra host parameter, "FL-Agent assign", lets a tool point one specific
+//   instance at a script: it writes the script path to assign-<token>.txt and
+//   sets the parameter to token / 1e6. The instance loads the script and resets
+//   the parameter to 0.
+static juce::File agentPendingFile()
+{
+    return juce::File::getSpecialLocation(juce::File::userApplicationDataDirectory)
+        .getChildFile("Application Support/FL-Agent/ysfx/pending.txt");
+}
+
+static juce::String agentClaimPendingScript()
+{
+    juce::File pending = agentPendingFile();
+    if (!pending.existsAsFile())
+        return {};
+
+    bool fresh = (juce::Time::getCurrentTime() - pending.getLastModificationTime()).inSeconds() < 30;
+    juce::File claimed = pending.getSiblingFile("claimed-" + juce::String::toHexString(juce::Random::getSystemRandom().nextInt64()));
+    if (!pending.moveFileTo(claimed))
+        return {};  // another instance claimed it first
+
+    juce::String path = claimed.loadFileAsString().trim();
+    claimed.deleteFile();
+    return fresh ? path : juce::String{};
+}
+
+// Tokens are encoded in the assign parameter as token / kAgentTokenScale
+static constexpr double kAgentTokenScale = 1e6;
+
+class AgentScriptWatcher : public juce::Timer {
+public:
+    AgentScriptWatcher(YsfxProcessor &processor, juce::AudioParameterFloat *assignParam)
+        : m_processor{processor}, m_assignParam{assignParam} { startTimer(250); }
+
+    void timerCallback() override
+    {
+        checkAssignment();
+        checkFileChanged();
+    }
+
+private:
+    void checkAssignment()
+    {
+        float value = m_assignParam ? m_assignParam->get() : 0.0f;
+        if (value <= 0.0f) {
+            m_assignWaits = 0;
+            return;
+        }
+
+        int token = juce::roundToInt(value * kAgentTokenScale);
+        juce::File request = agentPendingFile().getSiblingFile("assign-" + juce::String(token) + ".txt");
+        if (request.existsAsFile()) {
+            juce::String path = request.loadFileAsString().trim();
+            request.deleteFile();
+            if (path.isNotEmpty())
+                m_processor.loadJsfxFile(path, nullptr, true, false);
+        }
+        else if (++m_assignWaits < 20) {
+            return;  // give the request file up to ~5 s to appear
+        }
+
+        m_assignWaits = 0;
+        m_assignParam->setValueNotifyingHost(0.0f);
+    }
+
+    void checkFileChanged()
+    {
+        YsfxInfo::Ptr info = m_processor.getCurrentInfo();
+        if (!info || !info->effect)
+            return;
+
+        juce::File file{juce::CharPointer_UTF8{ysfx_get_file_path(info->effect.get())}};
+        if (file.getFullPathName().isEmpty() || !file.existsAsFile())
+            return;
+
+        juce::Time modified = file.getLastModificationTime();
+        if (file != m_file) {
+            m_file = file;
+            m_modified = modified;
+            return;
+        }
+        if (modified != m_modified) {
+            m_modified = modified;
+            m_processor.loadJsfxFile(file.getFullPathName(), nullptr, true, true);
+        }
+    }
+
+    YsfxProcessor &m_processor;
+    juce::AudioParameterFloat *m_assignParam = nullptr;
+    int m_assignWaits = 0;
+    juce::File m_file;
+    juce::Time m_modified;
 };
 
